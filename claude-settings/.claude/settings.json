{
  "permissions": {
    "allow": [
      "Bash(nvim-ctx *)",
      "Bash(rg *)",
      "Bash(grep -E \"\\\\.ts$\")",
      "Bash(gh api *)",
      "WebSearch",
      "Bash(vp check *)",
      "WebFetch(domain:github.com)"
    ],
    "defaultMode": "auto"
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "includeCoAuthoredBy": false,
  "skipWorkflowUsageWarning": true,
  "inputNeededNotifEnabled": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/comment-punctuation.py\""
          }
        ]
      }
    ]
  }
}
