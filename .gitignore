# alacritty theme set by alacritty-theme
alacritty/.config/alacritty/theme.toml

# environment variables
.env

# Python
__pycache__/

# Claude Code runtime (not the stow packages)
.claude/
!claude-md/.claude/
!claude-settings/.claude/
# claude.ai skills that Claude Code syncs into ~/.claude/skills, which stow links
# to this repo on machines where the folder is folded.
claude-md/.claude/skills/synced/

# Brew TUI dependencies
brews/node_modules/